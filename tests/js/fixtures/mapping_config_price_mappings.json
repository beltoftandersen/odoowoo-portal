                    },
                    {
                        "value": "pricelist",
                        "label": "Pricelist"
                    }
                ],
                "default": "list_price",
                "required": true,
                "missing": "choose a value."
            },
            {
                "key": "odoo_pricelist_id",
                "label": "Odoo pricelist",
                "type": "select",
