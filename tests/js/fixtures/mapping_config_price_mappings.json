                "showWhen": {
                    "key": "source",
                    "in": [
                        "pricelist"
                    ]
                }
            },
            {
                "key": "target_field",
                "label": "Write to",
                "type": "select",
                "options": [
                    {
                        "value": "regular_price",
                        "label": "Regular price"
                    },
                    {
                        "value": "sale_price",
                        "label": "Sale price"
                    },
                    {
                        "value": "meta",
                        "label": "Product meta field"
                    }
                ],
                "default": "regular_price",
                "required": true,
                "missing": "choose a value."
            },
            {
                "key": "target_meta_key",
                "label": "Meta key",
                "type": "text",
                "required": true,
                "missing": "enter the meta key to write.",
                "showWhen": {
                    "key": "target_field",
                    "in": [
                        "meta"
                    ]
                }
            },
            {
                "key": "tax_treatment",
