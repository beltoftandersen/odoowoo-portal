                    {
                        "value": "subtract_tax",
                        "label": "Subtract the product tax"
                    }
                ],
                "default": "as_is",
                "required": true,
                "missing": "choose a value."
            },
            {
                "key": "require_explicit_rule",
                "label": "Only products with their own pricelist rule",
